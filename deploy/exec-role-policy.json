{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNova2LiteOnly",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:${REGION}:${ACCOUNT}:inference-profile/us.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0"
      ]
    },
    {
      "Sid": "OwnLogGroupOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:${REGION}:${ACCOUNT}:log-group:/aws/lambda/homepulse-vision",
        "arn:aws:logs:${REGION}:${ACCOUNT}:log-group:/aws/lambda/homepulse-vision:*"
      ]
    }
  ]
}
